# Server-side only (Vercel Functions). Never prefix these with VITE_.
# Brave Search API key: https://api-dashboard.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=
# Random string used to hash client IPs for the per-visitor daily cap (openssl rand -hex 32).
RATE_LIMIT_SALT=
# Set by the Supabase integration on Vercel; `vercel env pull .env.local` fetches it.
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
# Optional caps (defaults shown).
DAILY_CLIENT_LIMIT=40
MONTHLY_QUERY_LIMIT=900
